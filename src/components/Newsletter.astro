---
// Reusable newsletter signup block. Posts to /api/submit (a Cloudflare
// Pages Function that emails the submission via Resend) — see README.
---

<section class="newsletter">
  <div class="container">
    <div class="inner">
      <p class="eyebrow">Stay close to the work</p>
      <h2>Join Monica's newsletter</h2>
      <p>
        Honest writing about reinvention, clarity, money, truth, and the courage to start over —
        plus updates on <em>The Family Narrative</em>. No noise. Just ideas worth sitting with.
      </p>
      <form
        class="nl-form"
        name="newsletter"
        method="POST"
        action="/api/submit"
        novalidate
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="nl-hp"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <input type="text" name="name" placeholder="Name" aria-label="Name" />
        <input type="email" name="email" placeholder="Email" aria-label="Email" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
      <p class="nl-micro">No spam, ever. Unsubscribe anytime.</p>
      <div class="nl-success"></div>
      <div class="nl-error">Something went wrong — please try again, or email monica@monicamesser.com directly.</div>
    </div>
  </div>
</section>
