---
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = [
  {
    title: 'When Not Knowing Is a Choice',
    blurb: 'Why financial independence requires more than earning your own money.',
  },
  {
    title: 'The Difference Between Loyalty and Complicity',
    blurb: 'At what point does protecting the people we love require us to stop protecting their story?',
  },
  {
    title: 'Passing the Problem Along',
    blurb: 'What happens when an institution solves its own problem without considering where the problem goes next?',
  },
  {
    title: 'What We Leave Behind',
    blurb: 'Possessions are easy to divide. The habits, wounds, values, and stories attached to them are not.',
  },
];
---

<BaseLayout
  active="writing"
  title="Writing — Monica Messer"
  description="Monica Messer's novels in progress — She Would Be Next and The Geography of Everlasting Life — her foreword to Francis La Flesche's The Middle Five — and occasional essays on the questions behind the fiction."
>
  <section class="tight">
    <div class="container narrow center" style="padding-top:40px;">
      <p class="eyebrow">Writing</p>
      <h1>What I'm Writing Next</h1>
      <p class="lede measure">
        The questions at the heart of <em>The Family Narrative</em> continue into Monica's next novels:
        What do we owe one another when we recognize something is wrong? When does looking away become
        complicity? And what, intentionally or not, do we pass on to the people who come after us?
      </p>
    </div>
  </section>

  <!-- SHE WOULD BE NEXT -->
  <section style="padding-top:0;">
    <div class="container">
      <div class="work-block">
        <div class="split-media">
          <img src="/assets/she-would-be-next-3d.png" alt="She Would Be Next by Monica Messer" class="cover-img" />
        </div>
        <div>
          <p class="work-status">A novel in development</p>
          <h2>She Would Be Next</h2>
          <p>
            A medical school removes a troubled physician from its residency program and quietly allows
            him to move on.
          </p>
          <p>Then another institution does the same. And another.</p>
          <p>
            Years later, when members of one of the committees responsible for his dismissal become
            targets, a female physician and professor who served on that committee begins looking back at
            decisions everyone believed were finished.
          </p>
          <p>What she discovers forces her to confront an uncomfortable question:</p>
          <p class="lede">
            When an institution protects itself by passing a problem along, who bears responsibility for
            what happens next?
          </p>
          <p>
            A novel of psychological suspense about professional silence, institutional self-protection, and
            the danger of believing that removing a threat is the same thing as resolving it.
          </p>
        </div>
      </div>

      <!-- THE GEOGRAPHY OF EVERLASTING LIFE -->
      <div class="work-block">
        <div class="split-media">
          <img src="/assets/geography-of-everlasting-life-3d.png" alt="The Geography of Everlasting Life by Monica Messer" class="cover-img" />
        </div>
        <div>
          <p class="work-status">A novel in development</p>
          <h2>The Geography of Everlasting Life</h2>
          <p>
            After Oliver and Sygne Thorson's lifetime of possessions is divided into numbered lots and sold
            at auction, their belongings scatter throughout a small Nebraska community.
          </p>
          <p>Then something strange begins to happen.</p>
          <p>
            A battered black roasting pan finds its way to a woman who begins cooking for a lonely
            neighbor. A worn pocketknife seems to carry its former owner's instinct to help. A harmonica
            and a porcelain angel begin to matter to their new owners in ways no one can quite explain.
          </p>
          <p>
            Elaine, the auctioneer's mother, knew Oliver and Sygne well enough to recognize what others
            cannot: the buyers have taken home more than objects. Something of the couple—their habits,
            generosity, resilience, wounds, and ways of loving—seems to have traveled with their
            possessions.
          </p>
          <p>
            But as Elaine traces what Oliver and Sygne have left behind, the mystery turns toward her own
            home and the husband she lost years earlier. Her resentment toward the harm he caused has made
            it easier to remember his failures than the man she once loved. Slowly, Elaine begins to wonder
            whether allowing what was good in him to live on requires her to excuse what was not.
          </p>
          <p>
            <em>The Geography of Everlasting Life</em> is an upmarket novel with elements of magical
            realism about the complicated inheritance of love: what the dead leave behind, what the living
            choose to carry forward, and whether we can forgive what hurt us without forgetting it.
          </p>
        </div>
      </div>

      <!-- THE MIDDLE FIVE -->
      <div class="work-block">
        <div class="split-media">
          <img src="/assets/the-middle-five-cover.png" alt="The Middle Five by Francis La Flesche, foreword by Monica Messer" class="cover-img" />
        </div>
        <div>
          <p class="work-status">A public-domain edition</p>
          <h2>The Middle Five</h2>
          <p class="lede" style="margin-top:0;">Francis La Flesche &middot; Foreword by Monica Messer</p>
          <p>
            Originally published by Francis La Flesche, <em>The Middle Five</em> offers a rare and deeply
            personal account of Omaha boys navigating life at a nineteenth-century boarding school during a
            period of profound cultural change.
          </p>
          <p>
            Monica discovered La Flesche's work while researching the Omaha Tribe for a novel and was moved
            by the wit, humanity, and historical value of his story. This edition is intended to help bring
            La Flesche's work to modern readers while honoring his voice and perspective.
          </p>
          <p>
            As you read, begin with La Flesche's original preface. It is essential to understanding the
            spirit of the book and the world he was trying to preserve on the page.
          </p>
          <div class="btn-group">
            <a href="/the-middle-five/" class="btn btn-primary">Learn More About The Middle Five</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NOTES & ESSAYS -->
  <section class="bg-sand">
    <div class="container narrow">
      <p class="eyebrow">Notes &amp; Essays</p>
      <p class="lede">Occasional writing about the questions behind the fiction.</p>
      <ul class="notes-list">
        {notes.map((note) => (
          <li>
            <h3>{note.title}</h3>
            <p>{note.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
