---
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = [
  {
    title: 'When Not Knowing Is a Choice',
    blurb: 'Why financial independence requires more than earning your own money.',
  },
  {
    title: 'The Difference Between Loyalty and Complicity',
    blurb: 'At what point does protecting the people we love require us to stop protecting their story?',
  },
  {
    title: 'Passing the Problem Along',
    blurb: 'What happens when an institution solves its own problem without considering where the problem goes next?',
  },
  {
    title: 'What We Leave Behind',
    blurb: 'Possessions are easy to divide. The habits, wounds, values, and stories attached to them are not.',
  },
];
---

<BaseLayout
  active="writing"
  title="Writing — Monica Messer"
  description="Monica Messer's novels in progress — She Would Be Next and The Geography of Everlasting Life — and occasional essays on the questions behind the fiction."
>
  <section class="tight">
    <div class="container narrow center" style="padding-top:40px;">
      <p class="eyebrow">Writing</p>
      <h1>What I'm Writing Next</h1>
      <p class="lede measure">
        The questions at the heart of <em>The Family Narrative</em> continue into Monica's next novels:
        What do we owe one another when we recognize something is wrong? When does looking away become
        complicity? And what, intentionally or not, do we pass on to the people who come after us?
      </p>
    </div>
  </section>

  <!-- SHE WOULD BE NEXT -->
  <section style="padding-top:0;">
    <div class="container">
      <div class="work-block">
        <div class="split-media">
          <img src="/assets/she-would-be-next.png" alt="She Would Be Next by Monica Messer" class="cover-img" />
        </div>
        <div>
          <p class="work-status">A novel in progress</p>
          <h2>She Would Be Next</h2>
          <p>
            A medical school removes a troubled physician from its residency program and quietly allows
            him to move on.
          </p>
          <p>Then another institution does the same.</p>
          <p>And another.</p>
          <p>
            Years later, when members of one of the committees responsible for his dismissal become targets,
            a female physician and professor who served on that committee begins looking backward at the
            decisions everyone believed were finished.
          </p>
          <p>What she discovers forces her to confront an uncomfortable question:</p>
          <p class="lede">
            When an institution protects itself by passing a problem along, who bears responsibility for
            what happens next?
          </p>
          <p>
            A novel of psychological suspense about professional silence, institutional self-protection, and
            the danger of believing that removing a threat is the same thing as resolving it.
          </p>
        </div>
      </div>

      <!-- THE GEOGRAPHY OF EVERLASTING LIFE -->
      <div class="work-block">
        <div>
          <p class="work-status">Working title — a novel in development</p>
          <h2>The Geography of Everlasting Life</h2>
          <p>
            After Oliver and Sygne Thorson's lifetime of possessions is divided into numbered lots and sold
            at auction, their belongings scatter throughout the community.
          </p>
          <p>Then something strange begins to happen.</p>
          <p>
            A battered black roasting pan finds its way to a woman who begins cooking for a lonely neighbor.
            A worn pocketknife seems to carry its former owner's instinct to help. A harmonica and a porcelain
            angel begin to matter to their new owners in ways no one can quite explain.
          </p>
          <p>
            The auctioneer's mother knew Oliver and Sygne well enough to recognize what others cannot: the
            buyers have taken home more than objects. Small pieces of the couple's habits, virtues, wounds,
            and ways of loving seem to have traveled with their possessions.
          </p>
          <p>
            As she begins tracing where everything went, she creates a second catalog—not of what Oliver and
            Sygne owned, but of what they left behind.
          </p>
          <p>
            <em>The Geography of Everlasting Life</em> is an upmarket novel with elements of magical realism
            about inheritance, community, memory, and the things of greatest value that can never be bought.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NOTES & ESSAYS -->
  <section class="bg-sand">
    <div class="container narrow">
      <p class="eyebrow">Notes &amp; Essays</p>
      <p class="lede">Occasional writing about the questions behind the fiction.</p>
      <ul class="notes-list">
        {notes.map((note) => (
          <li>
            <h3>{note.title}</h3>
            <p>{note.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
