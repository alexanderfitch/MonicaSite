---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  active="about"
  title="About Monica Messer — Author"
  description="Monica Messer is a debut novelist based in Omaha, Nebraska. Her completed novel, The Family Narrative, is approximately 72,000 words."
>
  <section class="hero">
    <div class="container split">
      <div class="split-media">
        <img src="/assets/author-portrait.jpg" alt="Portrait of Monica Messer" class="cover-img portrait" style="max-width:340px;" />
      </div>
      <div class="split-copy">
        <p class="eyebrow">About Monica</p>
        <h1 style="font-size:clamp(2rem,4.4vw,3.2rem);">Monica Messer</h1>
        <p>
          Monica Messer is a debut novelist based in Omaha, Nebraska. After a forty-year career in
          technology and executive leadership, she turned her attention to fiction and to questions that
          have followed her throughout her life: how families construct their stories, how institutions
          protect themselves, how women navigate power and responsibility, and how the choices one
          generation makes shape the next.
        </p>
        <p>
          She spent much of the 1990s in Northern California during the Internet startup era, an experience
          that informs the academic and professional world of <em>The Family Narrative</em>.
        </p>
        <p>
          When she isn't in Omaha, Monica spends time in Los Angeles with her daughter and siblings and at
          her home in Belize with her husband, where she particularly loves to write.
        </p>
        <p>
          Her debut novel, <em>The Family Narrative</em>, is complete at approximately 72,000 words.
        </p>
        <div class="btn-group">
          <a href="/the-family-narrative/" class="btn btn-primary">The Family Narrative</a>
          <a href="/contact/" class="btn btn-outline">Contact</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
