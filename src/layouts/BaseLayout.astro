---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const {
  title = 'Monica Messer — Author of The Family Narrative',
  description = 'Monica Messer is a debut novelist writing character-driven fiction about women, families, and institutions. Her completed novel is The Family Narrative.',
  active = '',
  bodyClass = '',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Enable motion only when the visitor hasn't asked for reduced motion.
       Set before paint so reveal animations never leave content stuck hidden. -->
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('motion-ok');
    }
  </script>

  <!-- Smooth animated transitions between pages -->
  <ClientRouter />
</head>
<body class={bodyClass}>
  <Nav active={active} />

  <main>
    <slot />
  </main>

  <Footer />

  <script>
    // Timers / observers we create per page, so we can tear them down on navigation.
    let timers: number[] = [];
    let observer: IntersectionObserver | null = null;

    function teardown() {
      timers.forEach((id) => clearInterval(id));
      timers = [];
      if (observer) { observer.disconnect(); observer = null; }
    }

    function init() {
      // ---- Mobile nav toggle ----
      const toggle = document.querySelector('.nav-toggle');
      const links = document.querySelector('.nav-links');
      if (toggle && links) {
        toggle.addEventListener('click', () => {
          const open = links.classList.toggle('open');
          toggle.classList.toggle('open', open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        links.addEventListener('click', (e) => {
          if (e.target instanceof HTMLAnchorElement) {
            links.classList.remove('open');
            toggle.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // ---- Newsletter + contact forms (Cloudflare Pages Function → Resend) ----
      document.querySelectorAll<HTMLFormElement>('.nl-form, .contact-form').forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = form.querySelector<HTMLInputElement>('input[name="email"]');
          if (email && !email.checkValidity()) { email.reportValidity(); return; }

          const success = form.parentNode?.querySelector('.nl-success, .form-success');
          const error = form.parentNode?.querySelector('.nl-error, .form-error');
          const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]');
          const name = nameInput ? nameInput.value : '';
          const isContact = form.classList.contains('contact-form');
          const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

          const showThanks = () => {
            form.style.display = 'none';
            if (success) {
              if (isContact) {
                success.textContent = 'Thank you — your message has been sent.';
              } else {
                const first = name.trim().split(' ')[0];
                success.textContent = first
                  ? `Thank you, ${first} — you're on the list.`
                  : "Thank you — you're on the list.";
              }
              success.classList.add('show');
            }
          };

          const showError = () => {
            if (error) error.classList.add('show');
          };

          error?.classList.remove('show');
          if (submitBtn) submitBtn.disabled = true;

          const body = new URLSearchParams(new FormData(form) as any).toString();
          fetch(form.getAttribute('action') || '/api/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body,
          })
            .then((res) => { if (res.ok) { showThanks(); } else { showError(); } })
            .catch(() => showError())
            .finally(() => { if (submitBtn) submitBtn.disabled = false; });
        });
      });

      // ---- Pull-quote rotator ----
      const rotator = document.querySelector('[data-quote-rotator]');
      if (rotator) {
        let quotes: string[] | null = null;
        try { quotes = JSON.parse(rotator.getAttribute('data-quotes') || 'null'); }
        catch { quotes = null; }
        const bq = rotator.querySelector('blockquote') as HTMLElement | null;
        if (quotes && quotes.length > 1 && bq) {
          let i = 0;
          bq.style.transition = 'opacity .4s ease';
          const id = window.setInterval(() => {
            i = (i + 1) % quotes!.length;
            bq.style.opacity = '0';
            setTimeout(() => { bq.textContent = quotes![i]; bq.style.opacity = '1'; }, 400);
          }, 6000);
          timers.push(id);
        }
      }

      // ---- Scroll reveal (gentle fade-up as sections enter the viewport) ----
      const sections = document.querySelectorAll('main > section');
      const motionOk = document.documentElement.classList.contains('motion-ok');
      if (!motionOk || !('IntersectionObserver' in window)) {
        sections.forEach((s) => s.classList.add('is-visible'));
      } else {
        observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
        sections.forEach((s) => observer!.observe(s));
      }
    }

    // Runs on first load and after every animated page transition.
    document.addEventListener('astro:page-load', init);
    // Clean up before the next page swaps in.
    document.addEventListener('astro:before-swap', teardown);
  </script>
</body>
</html>
